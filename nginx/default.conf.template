# 1. default — всё, что не совпало по server_name
server {
    listen 80 default_server;
    server_name _;

    # exact match — имеет приоритет над location /
    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    # 404 спрятан в location — теперь он НЕ перехватывает /healthz
    location / {
        return 404 "frontend not configured";
    }
}

# 2. API_HOST — проксируем всё как есть
server {
    listen 80;
    server_name ${API_HOST};

    location / {
        # раскомментируйте, когда будете готовы включить rate-limit
        # limit_req  zone=api_rl burst=40 nodelay;
        # limit_req_status 429;
        # limit_conn api_conn 20;

        set $upstream http://core-api:8080;
        proxy_pass $upstream;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }
}

# 3. Frontend-хосты — только /api/*, со strip_prefix /api
server {
    listen 80;
    server_name ${WEB_HOST} ${TMA_HOST} ${ADMIN_HOST};

    location /api/ {
        # limit_req  zone=api_rl burst=40 nodelay;
        # limit_req_status 429;
        # limit_conn api_conn 20;

        rewrite ^/api/(.*)$ /$1 break;
        set $upstream http://core-api:8080;
        proxy_pass $upstream;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    location / {
        return 404 "frontend not configured";
    }
}
